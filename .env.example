# Copy to .env and fill in. Never commit .env — it is gitignored.

# The only Discord credential in the system. Lives here and nowhere else;
# agents never receive it. Developer Portal → your app → Bot → Reset Token.
DISCORD_BOT_TOKEN=

# What agents are told to call back on. Must be reachable from wherever they
# run — not localhost, once anyone outside this machine is using it.
PUBLIC_URL=http://localhost:5585

# There is no channel setting. Per-server configuration lives in Discord:
# invite the bot, then run /switchboard enable in the channel you want.
# Env vars can't express per-guild anything, and a second way of naming a
# channel is a footgun.

# Strongly recommended while setting up. Global slash command sync can take up
# to an hour to appear in Discord; guild-scoped sync is instant. Enable Developer
# Mode (Settings → Advanced), then right-click your server → Copy Server ID.
# Leave unset in production so commands register everywhere the bot is invited.
DISCORD_DEV_GUILD_ID=

# Optional — defaults shown.
# WEBHOOK_NAME=Switchboard
# PORT=5585
# LOG_LEVEL=info
# TZ=America/New_York
